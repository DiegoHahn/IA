# Copie para .env e preencha. O arquivo .env não deve ser commitado.

# URL SQLAlchemy do PostgreSQL que contém a tabela log_motor (usada por previsao.py)
DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@localhost:5432/NOME_DO_BANCO

# Caminhos opcionais (os valores abaixo são os padrões)
IA_DATA_PATH=data/arquivoMotorIA.csv
IA_MODEL_PATH=models/isolation_forest_model.pkl
IA_SCALER_PATH=models/scaler.pkl
